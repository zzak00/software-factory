#!/usr/bin/env bash

set -euo pipefail

[[ ${1:-} == 'install' ]] || {
  printf 'fake pi supports only install\n' >&2
  exit 1
}
[[ -n ${2:-} && -d ${2:-} ]] || {
  printf 'local extension path is required: %s\n' "${2:-}" >&2
  exit 1
}
[[ -n ${PI_CODING_AGENT_DIR:-} ]] || {
  printf 'PI_CODING_AGENT_DIR is required\n' >&2
  exit 1
}

if [[ -n ${PI_PERMISSIONS_FAKE_LOG:-} ]]; then
  printf 'pi install %s\n' "$2" >>"$PI_PERMISSIONS_FAKE_LOG"
fi

if [[ ${PI_PERMISSIONS_FAKE_PI_FAIL:-false} == true ]]; then
  printf 'simulated Pi activation failure\n' >&2
  exit 1
fi

case $2 in
  "$PI_CODING_AGENT_DIR"/*)
    registered_path=${2#"$PI_CODING_AGENT_DIR"/}
    ;;
  *)
    printf 'extension is outside the Pi agent directory: %s\n' "$2" >&2
    exit 1
    ;;
esac

settings_file="$PI_CODING_AGENT_DIR/settings.json"
mkdir -p "$PI_CODING_AGENT_DIR"
if [[ ! -f "$settings_file" ]]; then
  printf '%s\n' '{}' >"$settings_file"
fi
settings_stage=$(mktemp "${TMPDIR:-/tmp}/pi-settings.XXXXXX")
jq --arg source "$registered_path" '
  .packages = (((.packages // []) + [$source]) | unique_by(if type == "string" then . else .source end))
' "$settings_file" >"$settings_stage"
mv "$settings_stage" "$settings_file"
