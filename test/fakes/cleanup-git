#!/usr/bin/env bash

set -euo pipefail

real_git=${CLEANUP_TEST_REAL_GIT:?}

if [[ "${CLEANUP_TEST_ADVANCE_BEFORE_DELETE:-false}" == true &&
  " $* " == *' push '* && " $* " == *' --delete '* &&
  ! -e "${CLEANUP_TEST_RACE_MARKER:?}" ]]; then
  : >"$CLEANUP_TEST_RACE_MARKER"
  "$real_git" --git-dir="${CLEANUP_TEST_RACE_REMOTE:?}" update-ref \
    "refs/heads/${CLEANUP_TEST_HEAD_BRANCH:?}" "${CLEANUP_TEST_RACE_OID:?}"
fi

exec "$real_git" "$@"
