#!/usr/bin/env bash

set -euo pipefail

state=$FACTORY_TEST_STATE
command_name=${1:-}
subcommand=${2:-}

has_state() {
  [[ -f "$state/$1" ]]
}

write_status_fields() {
  if has_state status_updated; then
    cat <<'EOF'
{"fields":[{"id":"PVTSSF_factory","name":"Status","options":[{"id":"triage","name":"Triage"},{"id":"planning","name":"Planning"},{"id":"spec-ready","name":"Spec Ready"},{"id":"ready","name":"Ready for Agent"},{"id":"progress","name":"In Progress"},{"id":"review","name":"In Review"},{"id":"done","name":"Done"}]}]}
EOF
  else
    cat <<'EOF'
{"fields":[{"id":"PVTSSF_default","name":"Status","options":[{"id":"todo","name":"Todo"},{"id":"progress","name":"In Progress"},{"id":"done","name":"Done"}]}]}
EOF
  fi
}

if [[ "$command_name" == api ]]; then
  shift
  request_arguments=$*
  method=GET
  endpoint=''
  has_input=false

  while [[ $# -gt 0 ]]; do
    case $1 in
      --method)
        method=$2
        shift 2
        ;;
      --input)
        has_input=true
        shift 2
        ;;
      --jq)
        shift 2
        ;;
      --silent)
        shift
        ;;
      --*)
        shift
        ;;
      *)
        [[ -z "$endpoint" ]] && endpoint=$1
        shift
        ;;
    esac
  done

  case "$method $endpoint" in
    'GET user')
      printf '%s\n' 'zzak00'
      ;;
    'GET graphql')
      if $has_input; then
        payload=$(cat)
        if [[ "$payload" == *updateProjectV2Field* ]]; then
          jq -e '
            .variables.input.fieldId == "PVTSSF_default" and
            ([.variables.input.singleSelectOptions[].name] ==
              ["Triage", "Planning", "Spec Ready", "Ready for Agent", "In Progress", "In Review", "Done"]) and
            .variables.input.singleSelectOptions[0].id == "todo" and
            .variables.input.singleSelectOptions[4].id == "progress" and
            .variables.input.singleSelectOptions[6].id == "done" and
            ([.variables.input.singleSelectOptions[] | .color] | all(type == "string")) and
            ([.variables.input.singleSelectOptions[] | .description] | all(length > 0))
          ' <<<"$payload" >/dev/null || {
            printf '%s\n' 'invalid Status update payload' >&2
            exit 1
          }
          : >"$state/status_updated"
          printf '%s\n' '{"data":{"updateProjectV2Field":{"projectV2Field":{"id":"PVTSSF_factory","name":"Status"}}}}'
        elif [[ "$payload" == *createProjectV2View* ]]; then
          jq -e '
            .variables.input.projectId == "PVT_factory" and
            .variables.input.name == "Kanban" and
            .variables.input.layout == "BOARD_LAYOUT"
          ' <<<"$payload" >/dev/null || {
            printf '%s\n' 'invalid Kanban creation payload' >&2
            exit 1
          }
          : >"$state/view_created"
          printf '%s\n' '{"data":{"createProjectV2View":{"projectV2View":{"id":"PVTV_kanban","name":"Kanban","layout":"BOARD_LAYOUT"}}}}'
        else
          printf '%s\n' 'unexpected GraphQL mutation' >&2
          exit 1
        fi
      else
        if [[ "$request_arguments" == *'repositories(first: 100)'* ]]; then
          if has_state linked; then
            printf '%s\n' '{"data":{"node":{"repositories":{"totalCount":1,"nodes":[{"id":"R_factory","nameWithOwner":"zzak00/scratch-project"}]}}}}'
          else
            printf '%s\n' '{"data":{"node":{"repositories":{"totalCount":0,"nodes":[]}}}}'
          fi
        elif has_state view_created; then
          printf '%s\n' '{"data":{"node":{"views":{"nodes":[{"id":"PVTV_table","name":"Table","layout":"TABLE_LAYOUT"},{"id":"PVTV_kanban","name":"Kanban","layout":"BOARD_LAYOUT"}]}}}}'
        else
          printf '%s\n' '{"data":{"node":{"views":{"nodes":[{"id":"PVTV_table","name":"Table","layout":"TABLE_LAYOUT"}]}}}}'
        fi
      fi
      ;;
    'GET repos/'*)
      if has_state repository; then
        printf '%s\n' '{"private":true,"visibility":"private"}'
      else
        printf '%s\n' 'gh: Not Found (HTTP 404)' >&2
        exit 1
      fi
      ;;
    *)
      printf 'unexpected gh api invocation: %s %s\n' "$method" "$endpoint" >&2
      exit 1
      ;;
  esac
  exit 0
fi

case "$command_name $subcommand" in
  'auth status')
    exit 0
    ;;
  'repo create')
    : >"$state/repository"
    printf '%s\n' 'wontfix|FFFFFF|This will not be worked on' >>"$state/labels"
    ;;
  'repo view')
    printf '%s\n' '{"projectsV2":null}'
    ;;
  'project list')
    project_list_calls=0
    if [[ -f "$state/project_list_calls" ]]; then
      read -r project_list_calls <"$state/project_list_calls"
    fi
    project_list_calls=$((project_list_calls + 1))
    printf '%s\n' "$project_list_calls" >"$state/project_list_calls"
    if [[ "${FACTORY_TEST_FAIL_PROJECT_LIST:-false}" == true ||
      "${FACTORY_TEST_FAIL_PROJECT_LIST_CALL:-0}" -eq "$project_list_calls" ]]; then
      printf '%s\n' 'simulated Project list failure' >&2
      exit 1
    elif has_state project; then
      printf '%s\n' '{"projects":[{"number":5,"title":"scratch-project Software Factory","url":"https://example.test/project/5"}]}'
    else
      printf '%s\n' '{"projects":[]}'
    fi
    ;;
  'project create')
    : >"$state/project"
    printf '%s\n' '{"number":5,"id":"PVT_factory","title":"scratch-project Software Factory","url":"https://example.test/project/5"}'
    ;;
  'project edit')
    exit 0
    ;;
  'project view')
    if [[ "${FACTORY_TEST_PROJECT_PUBLIC:-false}" == true ]]; then
      printf '%s\n' '{"number":5,"id":"PVT_factory","title":"scratch-project Software Factory","url":"https://example.test/project/5","public":true}'
    else
      printf '%s\n' '{"number":5,"id":"PVT_factory","title":"scratch-project Software Factory","url":"https://example.test/project/5","public":false}'
    fi
    ;;
  'project link')
    if has_state linked; then
      printf '%s\n' 'project is already linked' >&2
      exit 1
    fi
    : >"$state/linked"
    ;;
  'project field-list')
    write_status_fields
    ;;
  'project item-list')
    printf '%s\n' '{"totalCount":0,"items":[]}'
    ;;
  'label list')
    if [[ -s "$state/labels" ]]; then
      jq -Rn '[inputs | split("|") | {name: .[0], color: .[1], description: .[2]}]' <"$state/labels"
    else
      printf '%s\n' '[]'
    fi
    ;;
  'label create')
    label_name=$3
    shift 3
    label_color=''
    label_description=''
    while [[ $# -gt 0 ]]; do
      case $1 in
        --color) label_color=$2; shift 2 ;;
        --description) label_description=$2; shift 2 ;;
        --repo) shift 2 ;;
        *) shift ;;
      esac
    done
    printf '%s|%s|%s\n' "$label_name" "$label_color" "$label_description" >>"$state/labels"
    ;;
  'label edit')
    label_name=$3
    shift 3
    label_color=''
    label_description=''
    while [[ $# -gt 0 ]]; do
      case $1 in
        --color) label_color=$2; shift 2 ;;
        --description) label_description=$2; shift 2 ;;
        --repo) shift 2 ;;
        *) shift ;;
      esac
    done
    awk -F'|' -v OFS='|' -v name="$label_name" -v color="$label_color" -v description="$label_description" '
      $1 == name { $2 = color; $3 = description }
      { print }
    ' "$state/labels" >"$state/labels.updated"
    mv "$state/labels.updated" "$state/labels"
    ;;
  *)
    printf 'unexpected gh invocation: %s\n' "$*" >&2
    exit 1
    ;;
esac
